# EditorConfig helps maintain consistent coding styles

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{go,c,h}]
indent_style = tab
indent_size = 4

[*.{md,json,yaml,yml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
